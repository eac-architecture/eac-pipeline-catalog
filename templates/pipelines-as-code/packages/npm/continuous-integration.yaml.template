apiVersion: tekton.dev/v1
kind: PipelineRun
metadata:
  name: __REPOSITORY_NAME__-npm-ci
  annotations:
    pipelinesascode.tekton.dev/on-event: "[pull_request, push]"
    pipelinesascode.tekton.dev/on-target-branch: "[develop]"
    pipelinesascode.tekton.dev/pipeline: https://raw.githubusercontent.com/eac-architecture/eac-pipeline-catalog/v__CATALOG_RELEASE_VERSION__/catalog/profiles/packages/npm/pipelines/continuous-integration.yaml
spec:
  pipelineRef: {name: eac-npm-ci}
  params:
    - {name: repo-url, value: "{{ source_url }}"}
    - {name: revision, value: "{{ revision }}"}
  taskRunTemplate:
    serviceAccountName: eac-ci
    podTemplate:
      securityContext: {fsGroup: 1000, fsGroupChangePolicy: OnRootMismatch}
  workspaces:
    - name: source
      volumeClaimTemplate:
        spec:
          accessModes: [ReadWriteOnce]
          resources: {requests: {storage: 2Gi}}
